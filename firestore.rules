rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null
        && request.auth.token.firebase.sign_in_provider == 'google.com'
        && request.auth.token.email_verified == true;
    }
    function admin() {
      return signedIn()
        && request.auth.token.role == 'admin'
        && exists(/databases/$(database)/documents/admin_config/singleton)
        && get(/databases/$(database)/documents/admin_config/singleton).data.uid == request.auth.uid;
    }
    function owner(uid) { return signedIn() && request.auth.uid == uid; }
    // Public storefront fields only. Sensitive stock mutations go through the server.
    match /products/{id} {
      allow read: if resource.data.active == true || admin();
      allow write: if false;
    }
    match /journey/{id} {
      allow read: if resource.data.published == true || admin();
      allow write: if false;
    }
    match /site_content/{id} {
      allow read: if id == 'settings';
      allow write: if false;
    }
    match /users/{uid} {
      allow read: if owner(uid) || admin();
      // Roles and profiles are set by verified server code, never by a browser.
      allow write: if false;
    }
    match /preferences/{uid} {
      allow read: if owner(uid) || admin();
      allow write: if false;
    }
    match /orders/{id} {
      allow read: if signedIn() && (resource.data.userId == request.auth.uid || admin());
      allow write: if false;
    }
    match /messages/{id} {
      allow read: if admin();
      allow write: if false;
    }
    // Admin registry, payment ownership, idempotency records, rate limits and
    // audit events cannot be accessed by browser clients, even admin clients.
    match /{document=**} { allow read, write: if false; }
  }
}
